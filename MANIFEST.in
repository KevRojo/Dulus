include pyproject.toml
# Only ship the docs the runtime actually reads (news radio, webchat dashboard,
# favicon). The rest of docs/ (api.html, readme images, landing page, changelog)
# is for GitHub/Pages only and must NOT bloat every `pip install`.
include docs/news.md
include docs/dulus-bird.png
recursive-include docs/dashboard *
recursive-include data *
recursive-include sandbox/dist *
recursive-include webbridge *
recursive-include webchat_ui *.html *.css *.js
global-exclude __pycache__/*
global-exclude *.pyc
