# Self
.gitignore
.claude/

# Python bytecode / cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Python build artifacts
/dist/
/build/
*.egg-info/

# Project-specific binaries / archives
deepseek_pow.wasm
sha3_wasm_bg.*.wasm
*.zip

# Local Context
.dulus-context/

# Sandbox (Dulus OS) and the desktop GUI are not part of the public runtime.
# Both trees are kept private, so ignore them wholesale: a local working copy
# must never be committable into the public repo.
sandbox/
gui/

# Local MCP configs (may contain secrets/tokens)
.mcp.json
mcp.json

# Log / output files from local testing
err.txt
out.txt
out*.txt
output.txt

# Local screenshots and pasted working files
/uploads/

# MemPalace runtime cache
data/mempalace_cache.json
# Runtime context
data/context.json
# Runtime state (regenerated at runtime — never commit)
data/*.json

_pyright_*.json
_*.json

# CI test scratch (DULUS_HOME during pytest) — never commit
.dulus-ci/
.env
